# ==========================================
# PLATAFORMA DE TREINAMENTO PARA ÓPTICAS
# VARIÁVEIS DE AMBIENTE (CONFIGURAÇÃO)
# ==========================================

# Supabase (PostgreSQL, Auth, RLS & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (Emails Transacionais e Recuperação de Senha)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=suporte@optica.com.br

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Credenciais Padrão do Usuário Master de Demonstração
MASTER_DEFAULT_EMAIL=admin@optica.com.br
MASTER_DEFAULT_PASSWORD=MasterOptica2026!
